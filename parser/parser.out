    SUMA            reduce using rule 20 (factor -> IZQ_PAREN expr DER_PAREN .)
    RESTA           reduce using rule 20 (factor -> IZQ_PAREN expr DER_PAREN .)
    DER_PAREN       reduce using rule 20 (factor -> IZQ_PAREN expr DER_PAREN .)


state 42

    (7) sentencia -> IF IZQ_PAREN expr DER_PAREN sentencia .
    (8) sentencia -> IF IZQ_PAREN expr DER_PAREN sentencia . ELSE sentencia

    INT             reduce using rule 7 (sentencia -> IF IZQ_PAREN expr DER_PAREN sentencia .)
    ID              reduce using rule 7 (sentencia -> IF IZQ_PAREN expr DER_PAREN sentencia .)
    IF              reduce using rule 7 (sentencia -> IF IZQ_PAREN expr DER_PAREN sentencia .)
    WHILE           reduce using rule 7 (sentencia -> IF IZQ_PAREN expr DER_PAREN sentencia .)
    IZQ_BRACE       reduce using rule 7 (sentencia -> IF IZQ_PAREN expr DER_PAREN sentencia .)
    $end            reduce using rule 7 (sentencia -> IF IZQ_PAREN expr DER_PAREN sentencia .)
    DER_BRACE       reduce using rule 7 (sentencia -> IF IZQ_PAREN expr DER_PAREN sentencia .)
    ELSE            shift and go to state 44

  ! ELSE            [ reduce using rule 7 (sentencia -> IF IZQ_PAREN expr DER_PAREN sentencia .) ]


state 43

    (9) sentencia -> WHILE IZQ_PAREN expr DER_PAREN sentencia .

    INT             reduce using rule 9 (sentencia -> WHILE IZQ_PAREN expr DER_PAREN sentencia .)
    ID              reduce using rule 9 (sentencia -> WHILE IZQ_PAREN expr DER_PAREN sentencia .)
    IF              reduce using rule 9 (sentencia -> WHILE IZQ_PAREN expr DER_PAREN sentencia .)
    WHILE           reduce using rule 9 (sentencia -> WHILE IZQ_PAREN expr DER_PAREN sentencia .)
    IZQ_BRACE       reduce using rule 9 (sentencia -> WHILE IZQ_PAREN expr DER_PAREN sentencia .)
    $end            reduce using rule 9 (sentencia -> WHILE IZQ_PAREN expr DER_PAREN sentencia .)
    DER_BRACE       reduce using rule 9 (sentencia -> WHILE IZQ_PAREN expr DER_PAREN sentencia .)
    ELSE            reduce using rule 9 (sentencia -> WHILE IZQ_PAREN expr DER_PAREN sentencia .)


state 44

    (8) sentencia -> IF IZQ_PAREN expr DER_PAREN sentencia ELSE . sentencia
    (4) sentencia -> . INT ID PUNTO_COMA
    (5) sentencia -> . INT ID ASIGNACION expr PUNTO_COMA
    (6) sentencia -> . ID ASIGNACION expr PUNTO_COMA
    (7) sentencia -> . IF IZQ_PAREN expr DER_PAREN sentencia
    (8) sentencia -> . IF IZQ_PAREN expr DER_PAREN sentencia ELSE sentencia
    (9) sentencia -> . WHILE IZQ_PAREN expr DER_PAREN sentencia
    (10) sentencia -> . IZQ_BRACE lista_sentencias DER_BRACE

    INT             shift and go to state 4
    ID              shift and go to state 5
    IF              shift and go to state 6
    WHILE           shift and go to state 7
    IZQ_BRACE       shift and go to state 8

    sentencia                      shift and go to state 45

state 45

    (8) sentencia -> IF IZQ_PAREN expr DER_PAREN sentencia ELSE sentencia .

    INT             reduce using rule 8 (sentencia -> IF IZQ_PAREN expr DER_PAREN sentencia ELSE sentencia .)
    ID              reduce using rule 8 (sentencia -> IF IZQ_PAREN expr DER_PAREN sentencia ELSE sentencia .)
    IF              reduce using rule 8 (sentencia -> IF IZQ_PAREN expr DER_PAREN sentencia ELSE sentencia .)
    WHILE           reduce using rule 8 (sentencia -> IF IZQ_PAREN expr DER_PAREN sentencia ELSE sentencia .)
    IZQ_BRACE       reduce using rule 8 (sentencia -> IF IZQ_PAREN expr DER_PAREN sentencia ELSE sentencia .)
    $end            reduce using rule 8 (sentencia -> IF IZQ_PAREN expr DER_PAREN sentencia ELSE sentencia .)
    DER_BRACE       reduce using rule 8 (sentencia -> IF IZQ_PAREN expr DER_PAREN sentencia ELSE sentencia .)
    ELSE            reduce using rule 8 (sentencia -> IF IZQ_PAREN expr DER_PAREN sentencia ELSE sentencia .)

